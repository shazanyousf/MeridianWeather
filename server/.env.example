# ===================== SERVER PORT =====================
PORT=5000
NODE_ENV=development

# ===================== DATABASE =====================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meridian_weather?retryWrites=true&w=majority

# ===================== JWT =====================
JWT_ACCESS_SECRET=change_this_access_secret_super_long
JWT_REFRESH_SECRET=change_this_refresh_secret_super_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===================== CLIENT URL =====================
CLIENT_URL=http://localhost:3000

# ===================== EMAIL (NodeMailer / SMTP) =====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Meridian Weather <your-email@gmail.com>"

# ===================== CLOUDINARY =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===================== WEATHER APIs =====================
OPENWEATHER_API_KEY=your_openweather_api_key
WEATHERAPI_KEY=your_weatherapi_key

# ===================== CORS =====================
CORS_ORIGIN=http://localhost:3000

# ===================== RATE LIMITING =====================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=500
